# Database (MySQL)
DATABASE_URL="mysql://root:yourpassword@localhost:3306/psale_ultra"
# SQLite for offline sync (local)
SQLITE_DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3005
NODE_ENV=development
FRONTEND_URL="http://localhost:5175"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="P-Sale Ultra <noreply@psale.com>"

# WhatsApp (using WhatsApp Business API or Twilio)
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"

# Exchange Rate API
EXCHANGE_RATE_API_KEY="your-api-key"
EXCHANGE_RATE_BASE_URL="https://api.exchangerate-api.com/v4/latest"

# Sync
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MS=30000

# License System (Ed25519 + Hardware Binding)
# Relative to the server/ directory (PM2 cwd is ./server)
LICENSE_PUBLIC_KEY_PATH="../.keys/public_key.pem"
LICENSE_TRIAL_DAYS=30
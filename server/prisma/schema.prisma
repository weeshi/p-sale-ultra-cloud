  expectedArrival   DateTime? @map("expected_arrival")
  actualArrival     DateTime? @map("actual_arrival")
  targetWarehouseId Int?      @map("target_warehouse_id")
  notes             String?   @db.Text
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company   Company             @relation(fields: [companyId], references: [id])
  branch    Branch?             @relation(fields: [branchId], references: [id])
  party     Party               @relation(fields: [partyId], references: [id])
  items     PurchaseOrderItem[]
  shipments Shipment[]

  @@index([poNumber])
  @@index([branchId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int      @map("purchase_order_id")
  itemId          Int      @map("item_id")
  quantity        Decimal  @db.Decimal(15, 3)
  unitPriceUsd    Decimal  @map("unit_price_usd") @db.Decimal(15, 3)
  unitPriceLyd    Decimal  @map("unit_price_lyd") @db.Decimal(15, 3)
  discount        Decimal  @default(0) @db.Decimal(15, 3)
  totalUsd        Decimal  @map("total_usd") @db.Decimal(15, 3)
  totalLyd        Decimal  @map("total_lyd") @db.Decimal(15, 3)
  receivedQty     Decimal  @default(0) @map("received_qty") @db.Decimal(15, 3)

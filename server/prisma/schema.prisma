model SaleInvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @map("invoice_id")
  itemId    Int      @map("item_id")
  quantity  Decimal  @db.Decimal(15, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(15, 3)
  costPrice Decimal  @default(0) @map("cost_price") @db.Decimal(15, 3)
  discount  Decimal  @default(0) @db.Decimal(15, 3)
  total     Decimal  @db.Decimal(15, 3)
  createdAt DateTime @default(now()) @map("created_at")

  invoice SaleInvoice @relation(fields: [invoiceId], references: [id])
  item    Item        @relation(fields: [itemId], references: [id])
  serials Serial[]

  @@map("sale_invoice_items")
}

// ============================================
// سندات القبض والصرف
// ============================================
model Receipt {
  id                Int       @id @default(autoincrement())
  companyId         Int       @map("company_id")
  receiptNumber     String    @map("receipt_number") @db.VarChar(50)
  receiptDate       DateTime  @map("receipt_date")
  receiptType       String    @map("receipt_type") // receipt, payment
  partyId           Int?      @map("party_id")
  treasuryId        Int?      @map("treasury_id")
  branchId          Int?      @map("branch_id")
  currency          String    @default("LYD") @db.VarChar(3)
  exchangeRate      Decimal   @default(1) @map("exchange_rate") @db.Decimal(15, 6)
  amount            Decimal   @db.Decimal(15, 3)
  amountUsd         Decimal   @default(0) @map("amount_usd") @db.Decimal(15, 3)
  paymentMethod     String    @default("cash") @map("payment_method") // cash, check, transfer, card
  checkNumber       String?   @map("check_number") @db.VarChar(100)
  checkDate         DateTime? @map("check_date")
  bankName          String?   @map("bank_name") @db.VarChar(100)
  referenceNo       String?   @map("reference_no") @db.VarChar(100)
  saleInvoiceId     Int?      @map("sale_invoice_id")
  purchaseInvoiceId Int?      @map("purchase_invoice_id")
  journalEntryId    Int?      @map("journal_entry_id")
  notes             String?   @db.Text
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  party        Party?        @relation(fields: [partyId], references: [id])
  treasury     Treasury?     @relation(fields: [treasuryId], references: [id])
  journalEntry JournalEntry? @relation("ReceiptJournal", fields: [journalEntryId], references: [id])
  reconciliations BankReconciliationLine[]

  @@map("receipts")
}

// ============================================
// التسوية البنكية (مطابقة الحساب البنكي مع كشف المصرف)
// ============================================
model BankReconciliation {
  id               Int      @id @default(autoincrement())
  companyId        Int      @map("company_id")
  branchId         Int?     @map("branch_id")
  treasuryId       Int      @map("treasury_id")
  reconNumber      String   @map("recon_number") @db.VarChar(50)
  statementDate    DateTime @map("statement_date")
  openingBalance   Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 3)
  statementBalance Decimal  @default(0) @map("statement_balance") @db.Decimal(15, 3)
  systemBalance    Decimal  @default(0) @map("system_balance") @db.Decimal(15, 3)
  difference       Decimal  @default(0) @db.Decimal(15, 3)
  status           String   @default("draft") // draft, matched, completed
  notes            String?  @db.Text
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company  Company                    @relation(fields: [companyId], references: [id])
  branch   Branch?                    @relation(fields: [branchId], references: [id])
  treasury Treasury                   @relation(fields: [treasuryId], references: [id])
  lines    BankReconciliationLine[]

  @@index([treasuryId])
  @@index([branchId])
  @@map("bank_reconciliations")
}

model BankReconciliationLine {
  id              Int      @id @default(autoincrement())
  reconciliationId Int     @map("reconciliation_id")
  receiptId       Int      @map("receipt_id")
  isMatched       Boolean  @default(false) @map("is_matched")
  note            String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id])
  receipt        Receipt            @relation(fields: [receiptId], references: [id])

  @@unique([reconciliationId, receiptId])
  @@index([receiptId])
  @@map("bank_reconciliation_lines")
}

// ============================================
// القيود المحاسبية (دفتر الأستاذ)
// ============================================
model JournalEntry {
  id            Int            @id @default(autoincrement())
  companyId     Int            @map("company_id")
  entryNumber   Int            @map("entry_number")
  entryDate     DateTime       @map("entry_date")
  entryType     String         @map("entry_type") // purchase, sale, receipt, payment, adjusting, opening, transfer, return
  referenceType String?        @map("reference_type")
  referenceId   Int?           @map("reference_id")
  branchId      Int?           @map("branch_id")
  description   String?        @db.Text
  totalDebit    Decimal        @default(0) @map("total_debit") @db.Decimal(15, 3)
  totalCredit   Decimal        @default(0) @map("total_credit") @db.Decimal(15, 3)
  currency      String         @default("LYD") @db.VarChar(3)
  exchangeRate  Decimal        @default(1) @map("exchange_rate") @db.Decimal(15, 6)
  isPosted      Boolean        @default(true) @map("is_posted")
  isReversed    Boolean        @default(false) @map("is_reversed")
  reversedById  Int?           @map("reversed_by_id")
  reversedBy    JournalEntry?  @relation("ReverseRelation", fields: [reversedById], references: [id])
  reverseOf     JournalEntry[] @relation("ReverseRelation")
  createdBy     Int?           @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")

  company          Company            @relation(fields: [companyId], references: [id])
  lines            JournalEntryLine[]
  creator          User?              @relation(fields: [createdBy], references: [id])
  purchaseInvoices PurchaseInvoice[]  @relation("PurchaseJournal")
  saleInvoices     SaleInvoice[]      @relation("SaleJournal")
  receipts         Receipt[]          @relation("ReceiptJournal")

  @@index([entryDate])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             Int      @id @default(autoincrement())
  journalEntryId Int      @map("journal_entry_id")
  lineNumber     Int      @map("line_number")
  accountId      Int      @map("account_id")
  description    String?  @db.VarChar(255)
  debit          Decimal  @default(0) @db.Decimal(15, 3)
  credit         Decimal  @default(0) @db.Decimal(15, 3)
  partyId        Int?     @map("party_id")
  currency       String   @default("LYD") @db.VarChar(3)
  currencyAmount Decimal? @map("currency_amount") @db.Decimal(15, 3)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("journal_entry_lines")
}

// ============================================
// تحويلات المخزون بين الفروع

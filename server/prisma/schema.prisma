  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 3)
  discount       Decimal  @default(0) @db.Decimal(15, 3)
  total          Decimal  @default(0) @db.Decimal(15, 3)
  paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 3)
  paymentStatus  String   @default("unpaid") @map("payment_status") // paid, partial, unpaid
  payType        String?  @map("pay_type") @db.VarChar(20) // cash, credit, banking

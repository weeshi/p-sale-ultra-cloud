}

// الشحنات
model Shipment {
  id              Int       @id @default(autoincrement())
  companyId       Int       @map("company_id")
  purchaseOrderId Int?      @map("purchase_order_id")
  shipmentNumber  String    @map("shipment_number") @db.VarChar(50)
  carrier         String?   @db.VarChar(100)
  trackingNumber  String?   @map("tracking_number") @db.VarChar(100)
  portOfLoading   String?   @map("port_of_loading") @db.VarChar(100)
  portOfDischarge String?   @map("port_of_discharge") @db.VarChar(100)
  shipmentDate    DateTime? @map("shipment_date")
  arrivalDate     DateTime? @map("arrival_date")
  shippingCost    Decimal   @default(0) @map("shipping_cost") @db.Decimal(15, 3)

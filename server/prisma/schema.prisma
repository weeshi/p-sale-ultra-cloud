  unitCost     Decimal  @default(0) @map("unit_cost") @db.Decimal(15, 3) // التكلفة النهائية بعد التوزيع
  discount     Decimal  @default(0) @db.Decimal(15, 3)
  total        Decimal  @db.Decimal(15, 3)
  createdAt    DateTime @default(now()) @map("created_at")

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  item    Item            @relation(fields: [itemId], references: [id])
  serials Serial[]

  @@map("purchase_invoice_items")
}

// ============================================
// عروض الأسعار (فاتورة عرض)

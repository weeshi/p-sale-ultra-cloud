  createdAt   DateTime @default(now()) @map("created_at")

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  item     Item          @relation(fields: [itemId], references: [id])

  @@map("stock_transfer_items")
}

// ============================================
// الضمان والصيانة RMA
// ============================================
model Warranty {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  warrantyNumber String   @map("warranty_number") @db.VarChar(50)
  serialId       Int      @map("serial_id")
  saleInvoiceId  Int?     @map("sale_invoice_id")
  partyId        Int?     @map("party_id")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  warrantyType   String   @map("warranty_type") // manufacturer, store, extended
  status         String   @default("active") // active, expired, claimed, void
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  company     Company      @relation(fields: [companyId], references: [id])
  serial      Serial       @relation(fields: [serialId], references: [id])
  saleInvoice SaleInvoice? @relation(fields: [saleInvoiceId], references: [id])
  party       Party?       @relation(fields: [partyId], references: [id])
  rmas        Rma[]

  @@map("warranties")
}

model Rma {
  id                  Int       @id @default(autoincrement())
  companyId           Int       @map("company_id")
  rmaNumber           String    @map("rma_number") @db.VarChar(50)
  rmaDate             DateTime  @map("rma_date")
  partyId             Int       @map("party_id")
  warrantyId          Int?      @map("warranty_id")
  rmaType             String    @map("rma_type") // repair, replace, refund, return
  status              String    @default("open") // open, received, diagnosed, repairing, awaiting_parts, repaired, replaced, refunded, closed
  issueDescription    String?   @map("issue_description") @db.Text
  diagnosis           String?   @db.Text
  actionTaken         String?   @map("action_taken") @db.Text
  technicianId        Int?      @map("technician_id")
  repairCost          Decimal   @default(0) @map("repair_cost") @db.Decimal(15, 3)
  partsCost           Decimal   @default(0) @map("parts_cost") @db.Decimal(15, 3)
  receivedAt          DateTime? @map("received_at")
  returnedAt          DateTime? @map("returned_at")
  replacementSerialId Int?      @map("replacement_serial_id")
  notes               String?   @db.Text
  createdBy           Int?      @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  party    Party     @relation(fields: [partyId], references: [id])
  warranty Warranty? @relation(fields: [warrantyId], references: [id])
  items    RmaItem[]

  @@map("rmas")
}

model RmaItem {
  id        Int      @id @default(autoincrement())
  rmaId     Int      @map("rma_id")
  serialId  Int?     @map("serial_id")
  itemId    Int      @map("item_id")
  quantity  Decimal  @default(1) @db.Decimal(15, 3)
  createdAt DateTime @default(now()) @map("created_at")

  rma    Rma     @relation(fields: [rmaId], references: [id])
  serial Serial? @relation(fields: [serialId], references: [id])
  item   Item    @relation(fields: [itemId], references: [id])

  @@map("rma_items")
}

// ============================================
// سجل التدقيق
// ============================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(20)
  tableName String   @map("table_name") @db.VarChar(100)
  eventType String?  @map("event_type") @db.VarChar(50)
  recordId  Int?     @map("record_id")
  oldValues String?  @map("old_values") @db.Text
  newValues String?  @map("new_values") @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([tableName, recordId])
  @@map("audit_logs")
}

// ============================================
// سجل المزامنة
// ============================================
model SyncLog {
  id           Int       @id @default(autoincrement())
  companyId    Int       @map("company_id")
  deviceId     String    @map("device_id") @db.VarChar(255)
  syncType     String    @map("sync_type") @db.VarChar(50)
  tablesSynced String?   @map("tables_synced") @db.Text
  recordsCount Int       @default(0) @map("records_count")
  status       String    @default("success")
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("sync_logs")
}

// ============================================
// نظام الترخيص (License System)
// Ed25519 + Hardware Binding
// ============================================
model License {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  licenseKey  String   @unique @map("license_key") @db.VarChar(255)
  tier        String   @db.VarChar(50) // trial | basic | pro | enterprise
  hwHash      String   @map("hw_hash") @db.VarChar(255) // CPU+MAC fingerprint (SHA256)
  activatedAt DateTime @default(now()) @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  maxUsers    Int?     @map("max_users")
  maxBranches Int?     @map("max_branches")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?  @db.Text
  features    LicenseFeature[]
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([licenseKey])
  @@map("licenses")
}

model LicenseFeature {
  id        Int     @id @default(autoincrement())
  licenseId Int     @map("license_id")
  feature   String  @db.VarChar(100) // e.g. "accounting", "inventory", "multi-branch"
  enabled   Boolean @default(true)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, feature])
  @@map("license_features")
}

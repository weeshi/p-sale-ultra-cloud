# =====================================================================
# P-Sale Ultra Cloud — إعدادات تشفير ورفع النسخ الاحتياطية الخارجية
# انسخ هذا الملف إلى scripts/backup-encryption.env (مستبعد من git)
# ثم املأ القيم — ذاك هو الملف الذي يستخدمه backup.ps1 / backup.sh
# لا ترفع backup-encryption.env أبداً إلى المستودع.
# =====================================================================

# كلمة مرور تشفير النسخ (AES-256-CBC عبر openssl) — اجعلها قوية وفريدة
BACKUP_PASSPHRASE=change-me-to-a-strong-passphrase

# اسم remote من rclone (أنشئه بـ: rclone config) — عادة gdrive
RCLONE_REMOTE=gdrive

# المجلد داخل الـ remote (يُنشأ تلقائياً)
RCLONE_REMOTE_DIR=p-sale-backups

# أيام الاحتفاظ بالنسخ المشفرة على الـ remote (حذف القديم تلقائياً)
RCLONE_KEEP_DAYS=30
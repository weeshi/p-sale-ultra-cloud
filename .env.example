# ====================== P-Sale Ultra Cloud — Docker Compose Env ======================
# انسخ هذا الملف إلى .env وعدّل القيم الحساسة قبل التشغيل

# قاعدة البيانات
MYSQL_ROOT_PASSWORD=psale_root_change_me
MYSQL_DATABASE=psale_ultra
MYSQL_USER=psale
MYSQL_PASSWORD=psale_pass_change_me

# JWT — مطلوبة (إلزامية)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# البريد (اختياري)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=P-Sale Ultra <noreply@psale.com>

# WhatsApp (اختياري)
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# سعر الصرف (اختياري)
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://api.exchangerate-api.com/v4/latest

# مزامنة
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MS=30000
